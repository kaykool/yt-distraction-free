#!/usr/bin/env sh
set -e

msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | head -n 1 || true)"

case "$subject" in
  "")
    echo "commit-msg: empty commit subject." >&2
    exit 1
    ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|perf|chore|docs|test|refactor|ci|build|style|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: invalid Conventional Commit subject: $subject" >&2
  echo "Expected: <type>[optional scope]: <description> (e.g. feat:, fix:, perf:, chore:, docs:, test:)" >&2
  exit 1
fi
